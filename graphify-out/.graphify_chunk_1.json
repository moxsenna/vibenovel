      "id": "agents_verbatimmodulesyntax",
      "label": "verbatimModuleSyntax Compliance",
      "file_type": "rationale",
      "source_file": "AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Enforced verbatimModuleSyntax: true in tsconfig.json requires type-only imports to ensure clean compilation and type safety without runtime import side-effects."
    },
    {
      "id": "architecture_clientsideonly",
      "label": "Client-Side Only Architecture",
      "file_type": "rationale",
      "source_file": "architecture.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "100% client-side (SPA) design using browser service layers to invoke Supabase and AI provider APIs directly, enabling static deployment (Vercel/Netlify) and instant Capacitor wrapping for mobile platforms without custom backend server code."
    },
    {
      "id": "architecture_byok",
      "label": "BYOK & Local Keyring Security",
      "file_type": "rationale",
      "source_file": "architecture.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Users' Gemini and OpenRouter API keys are saved exclusively in the client's local storage using encrypted Zustand persist middleware. This avoids transferring, logging, or storing sensitive keys on any external server, ensuring data privacy and BYOK compliance."
    },
    {
      "id": "architecture_antiflicker",
      "label": "Theme Synchronization (Anti-Flicker)",
      "file_type": "rationale",
      "source_file": "architecture.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Default dark theme is instantly synchronized to document.documentElement via a small inline script before React renders to prevent white-flash layout shifts during page loading."
    },
    {
      "id": "architecture_fourlayermemory",
      "label": "4-Layer Memory System",
      "file_type": "rationale",
      "source_file": "architecture.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "A structured memory system that manages context pruning to fit prompts within standard token budgets: Layer 1 (Static Bible), Layer 2 (Dynamic State per Chapter), Layer 3 (RAG summaries from Supabase pgvector), and Layer 4 (Sliding Window of recent text/outlines)."
    },
    {
      "id": "architecture_aiprovider",
      "label": "AI Provider Hierarchy",
      "file_type": "rationale",
      "source_file": "architecture.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "AI Router sends non-prose core operations to free Gemini API pool (using multi-key round-robin rotation) and gives the user a toggle option to route prose generation to OpenRouter (Claude/Deepseek) or Gemini."
    },
